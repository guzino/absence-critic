# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
# xAI: OPENAI_BASE_URL=https://api.x.ai/v1 (OPENAI_API_KEY is your xAI key; set ABSENCECRITIC_MODEL to a current Grok model)
# Local generate/revise server: OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# ABSENCECRITIC_MODEL=gpt-4o-mini
