#
# Optional live provider. Tests and CI default to fixtures.
# Copy to .env (gitignored) and set the key.

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
# xAI: OPENAI_BASE_URL=https://api.x.ai/v1 (OPENAI_API_KEY is your xAI key; set ABSENCECRITIC_MODEL to a current Grok model)
# Local generate/revise server: OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# ABSENCECRITIC_MODEL=gpt-4o-mini
# OpenRouter example model: ABSENCECRITIC_MODEL=openai/gpt-4o-mini
# Local server: set ABSENCECRITIC_MODEL to a model served by your endpoint
# ABSENCECRITIC_HTTP_TIMEOUT=120
# ABSENCECRITIC_HTTP_RETRIES=3
# ABSENCECRITIC_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# ABSENCECRITIC_LOCAL_CRITIC_MODEL=absencecritic-critic
# ABSENCECRITIC_LOCAL_API_KEY=local
# Benchmark judge on a different provider (eval/benchmark/score.py --judge openai).
# A judge base URL needs its own key; the answering key is never reused for it.
# ABSENCECRITIC_JUDGE_BASE_URL
# ABSENCECRITIC_JUDGE_API_KEY
# ABSENCECRITIC_JUDGE_MODEL
# ABSENCECRITIC_STORE=
# ABSENCECRITIC_FIXTURES=
